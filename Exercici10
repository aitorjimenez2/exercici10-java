public class Exercici10 {
    public static void main(String[] args) {
        Scanner aitor = new Scanner(System.in);

        int[] a = new int[5];
        int[] b = new int[5];
        int[] resultat = new int[5];

        for (int i = 0; i < 5; i++) {
            System.out.println("Posa un numero per a:");
            a[i] = aitor.nextInt();
        }

        for (int i = 0; i < 5; i++) {
            System.out.println("Posa un numero per b:");
            b[i] = aitor.nextInt();
        }

        for (int i = 0; i < 5; i++) {
            resultat[i] = a[i] + b[i];
        }

        for (int i = 0; i < 5; i++) {
            System.out.println("Posició: " + i);
            System.out.println("a: " + a[i]);
            System.out.println("b: " + b[i]);
            System.out.println("Resultat: " + resultat[i]);
        }

        aitor.close();
    }
}
